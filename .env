# .env

# ──────────────────────────────────────────────
# Elastic Stack Version
# ──────────────────────────────────────────────

# Version of Elastic products
# https://www.elastic.co/docs/release-notes/elasticsearch
ELASTIC_VERSION=9.5.5

# ──────────────────────────────────────────────
# Credentials
# ──────────────────────────────────────────────

# Password for the built-in 'elastic' superuser (min. 6 characters)
ELASTIC_PASSWORD=changeme

# Password for the built-in 'kibana_system' user (min. 6 characters)
# Used internally by Kibana to communicate with Elasticsearch
KIBANA_PASSWORD=changeme

# Password for the dedicated 'logstash_internal' user (min. 6 characters)
# Used by the Logstash pipeline to write events to Elasticsearch
LOGSTASH_PASSWORD=changeme

# ──────────────────────────────────────────────
# Kibana Encryption Keys (min. 32 characters)
# ──────────────────────────────────────────────

# Used to encrypt saved objects (dashboards, visualizations, etc.)
KIBANA_ENCRYPTION_KEY=min-32-char-long-encryption-key-here

# Used to encrypt the credentials stored with reporting jobs (keeps pending reports valid across restarts)
KIBANA_REPORTING_KEY=min-32-char-long-reporting-key-here

# Used to encrypt session information (session cookies)
KIBANA_SECURITY_KEY=min-32-char-long-security-key-here

# ──────────────────────────────────────────────
# Cluster Settings
# ──────────────────────────────────────────────

# Elasticsearch cluster name
CLUSTER_NAME=elk-cluster

# License type: 'basic' (free) or 'trial' (30-day full features)
LICENSE=basic

# ──────────────────────────────────────────────
# Exposed Ports
# ──────────────────────────────────────────────

# Elasticsearch HTTP API port
ES_PORT=9200

# Kibana web UI port
KB_PORT=5601

# ──────────────────────────────────────────────
# Memory Limits (in bytes)
# Tune based on available host memory
# ──────────────────────────────────────────────

# Elasticsearch: 4 GB - set ES_JAVA_OPTS heap to half (2g/2g)
ES_MEM_LIMIT=4294967296

# Kibana: 2 GB
KB_MEM_LIMIT=2147483648

# Logstash: 2 GB - set LS_JAVA_OPTS heap to half (1g/1g)
LS_MEM_LIMIT=2147483648
